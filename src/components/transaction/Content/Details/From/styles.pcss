.from {
	display: flex;
	flex-direction: row;
	width: 100%;
	align-items: flex-start;
	gap: var(--space-m);

	& .from_label {
		font-size: 0.875rem;
		color: var(--color-gray-500);
		line-height: 1.125rem;
	}

	& .from_content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: var(--space-s);
		width: 100%;
		gap: var(--space-s);
		border-radius: var(--border-radius-medium);
		background: var(--color-gray-50);
	}
}

.from > :nth-child(1) {
	width: 28%;
}

.from > :nth-child(2) {
	width: 72%;
}

@media (max-width: 640px) {
	.from {
		flex-direction: column;
		gap: var(--space-xs);

		& > :nth-child(1),
		& > :nth-child(2) {
			width: 100%;
		}
	}
}
