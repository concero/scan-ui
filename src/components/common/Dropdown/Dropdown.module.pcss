.dropdown {
	position: relative;
	display: inline-block;

	.trigger {
		cursor: pointer;
	}

	.popup {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		z-index: 1000;
		padding: var(--space-s);
		overflow: hidden;
		border-radius: var(--space-m);
		background: var(--color-gray-25);

		/* Elevation */
		box-shadow:
			0 4px 8px 0 rgba(16, 24, 40, 0.15),
			0 2px 12px 0 rgba(16, 24, 40, 0.15);

		opacity: 0;
		transition: opacity 300ms ease;
		pointer-events: none;
	}
	.popup_visible {
		opacity: 1;

		pointer-events: auto;
	}

	.popup_headless {
		all: unset;
		display: block;
	}
}
