& .retry {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-xs);
	margin-top: var(--space-xxs);
	width: 100%;

	& .retry_warning {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		width: 100%;
	}

	& .retry_warning_text {
		font-size: 0.875rem;
		color: var(--color-gray-600);
		line-height: 1.125rem;
	}
}
