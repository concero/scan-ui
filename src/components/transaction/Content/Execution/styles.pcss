.execution {
	display: flex;
	flex-direction: column;
	gap: var(--space-s);
	width: 100%;

	& .execution_toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		height: 32px;
		cursor: pointer;

		& .execution_toggle_label {
			font-size: 1rem;
			color: var(--color-gray-600);
			line-height: 1.125rem;
		}

		& .execution_toggle_icon {
			display: flex;
			width: 24px;
			height: 24px;
			justify-content: center;
			align-items: center;
			background: var(--color-gray-100);
			border-radius: var(--border-radius-small);
			transition: transform 0.3s ease;
			transform: rotate(180deg);
		}

		& .execution_toggle_icon.rotated {
			transform: rotate(0deg);
		}
	}

	& .execution_content {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		width: 100%;
		overflow: hidden;
	}

	& .execution_content_togglable {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		width: 100%;
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height 0.4s ease,
			opacity 0.3s ease;

		&.expanded {
			max-height: 1000px;
			opacity: 1;
		}
	}
}
