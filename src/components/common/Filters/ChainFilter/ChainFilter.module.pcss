.wrap_filter {
	min-width: 254px;
	height: 318px;
}
.list_chains {
	height: 100%;
	overflow: auto;
	position: relative;
	&::after {
		content: '';
		position: sticky;
		bottom: 0;
		left: 0;
		right: 0;
		min-height: 16px;
		width: 100%;
		background: linear-gradient(180deg, rgba(252, 252, 253, 0) 0%, var(--color-gray-25) 100%);
		pointer-events: none;
		z-index: 1;
	}
	.chain_item {
		justify-content: flex-start !important;
	}
}
.chain_icon {
	width: 20px;
	height: 20px;
	border-radius: 30%;
}
