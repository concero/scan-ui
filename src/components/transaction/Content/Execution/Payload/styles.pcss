.payload {
	display: flex;
	flex-direction: row;
	width: 100%;
	height: 100%;
	gap: var(--space-m);
	min-height: 24px;

	& > :nth-child(1) {
		width: 26%;
	}

	& > :nth-child(2) {
		width: 74%;
	}

	& .payload_content {
		display: flex;
		flex-direction: column;
		padding: var(--space-s);
		max-width: 395px;
		max-height: 152px;
		width: 100%;
		border-radius: var(--border-radius-medium);
		background: var(--color-gray-50);
		gap: var(--space-xs);
	}

	& .payload_label {
		font-size: 0.875rem;
		color: var(--color-gray-500);
		line-height: 1.125rem;
	}

	& .payload_value {
		font-size: 0.875rem;
		color: var(--color-gray-700);
		line-height: 1.125rem;
		max-height: 80px;
		overflow-y: auto;
		word-break: break-all;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		position: relative;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	& .payload_value::-webkit-scrollbar {
		display: none;
	}

	& .payload_action {
		display: flex;
		justify-content: flex-start;
		height: 32px;
	}
}

@media (max-width: 640px) {
	.payload {
		flex-direction: column;
		gap: var(--space-xs);

		& > :nth-child(1),
		& > :nth-child(2) {
			width: 100%;
			min-width: 0;
		}
	}
}
