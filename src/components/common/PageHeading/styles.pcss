.page_heading {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-xl);
	width: 100%;

	& .page_heading_description {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);

		& .page_heading_info {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: var(--space-xs);
			width: 100%;

			& .page_heading_icon {
				display: flex;
				height: 32px;
				min-width: 79px;
				border-radius: var(--border-radius-xlarge);
				background: var(--color-gray-100);
				align-items: center;
				justify-content: center;
				font-size: 0.875rem;
				color: var(--color-gray-700);
				line-height: 1.125rem;
			}
		}

		& .page_heading_content {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			width: 100%;
			gap: var(--space-xxs);

			& .page_heading_title {
				font-size: 2rem;
				font-weight: 500;
				text-align: center;
				line-height: 2.25rem;
				color: var(--color-gray-700);
				letter-spacing: -0.64px;
				word-break: break-word;
				white-space: normal;
				overflow-wrap: anywhere;
			}

			& .page_heading_subtitle {
				font-size: 0.875rem;
				font-style: normal;
				font-weight: 400;
				line-height: 1.125rem;
				color: var(--color-gray-600);
				word-break: break-word;
				white-space: normal;
				overflow-wrap: anywhere;
				text-align: center;
			}
		}
	}
}
