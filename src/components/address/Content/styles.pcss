& .address_content {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-xl);
	width: 100%;

	& .address_description {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-s);

		& .address_info {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: var(--space-xs);
			width: 100%;

			& .address_subtitle {
				font-size: 0.875rem;
				font-weight: 400;
				line-height: 1.125rem;
				color: var(--color-600);
			}
		}

		& .address_title {
			font-size: 2rem;
			font-weight: 500;
			text-align: center;
			line-height: 2.25rem;
			color: var(--color-gray-700);
			letter-spacing: -0.64px;
			word-break: break-word;
			white-space: normal;
			overflow-wrap: anywhere;
		}
	}
}

@media (max-width: 640px) {
	.address_content .address_description .address_title {
		font-size: 1.5rem;
		line-height: 1.75rem;
		letter-spacing: -0.48px;
	}
}
